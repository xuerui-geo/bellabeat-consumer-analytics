  <worksheets>
    <worksheet name='Avg calories burned per day, by daily steps'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Avg calories burned per day, by daily steps</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Calories by Step Band' name='federated.stepband' />
          </datasources>
          <datasource-dependencies datasource='federated.stepband'>
            <column datatype='real' default-format='n#,##0' caption='Avg calories / day' name='[avg_calories]' role='measure' type='quantitative' />
            <column datatype='string' caption='Daily steps' name='[step_band]' role='dimension' type='nominal' />
            <column-instance column='[step_band]' derivation='None' name='[none:step_band:nk]' pivot='key' type='nominal' />
            <column-instance column='[avg_calories]' derivation='Sum' name='[sum:avg_calories:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <text column='[federated.stepband].[sum:avg_calories:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.stepband].[sum:avg_calories:qk]</rows>
        <cols>[federated.stepband].[none:step_band:nk]</cols>
      </table>
    </worksheet>
